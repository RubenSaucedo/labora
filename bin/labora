#!/usr/bin/env node
// labora's single entry point for every deterministic tool.
//
// This file imports nothing outside Node's standard library, on purpose. It has
// to be able to run and explain itself on a fresh plugin install, which is
// exactly the situation where no dependency is installed yet.
import { spawnSync } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import {
  classifyNpmFailure,
  sanitizeNpmOutput,
  sanitizeRegistryUrl,
} from "../src/lib/dependency-install-diagnostics.js";
import { requiredDependencies } from "../src/lib/tool-dependencies.js";

// bin/labora -> the plugin root is one level up. Derived from this file's own
// location rather than the caller's, because a plugin is installed to a path
// nobody can predict and is invoked from a directory that is never it.
const pluginRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const toolsDir = path.join(pluginRoot, "src", "tools");
const binPath = path.join(pluginRoot, "bin", "labora");
const SETUP_COMMAND = "labora setup";

function pluginVersion() {
  const manifest = path.join(pluginRoot, "package.json");
  if (!fs.existsSync(manifest)) return "(unknown version)";
  return JSON.parse(fs.readFileSync(manifest, "utf8")).version || "(unknown version)";
}

// Tools live at src/tools/<group>/<name>.js and are invoked as
// `labora <group> <name>`. They used to be 42 flat files, which meant nobody --
// including the assistant driving them -- could tell what the plugin actually
// did without reading every one. Grouping is the whole point: `labora list`
// now answers "what can this thing do" in one screen.
function availableTools() {
  if (!fs.existsSync(toolsDir)) return [];
  const tools = [];
  for (const group of fs.readdirSync(toolsDir, { withFileTypes: true })) {
    if (!group.isDirectory()) continue;
    const groupDir = path.join(toolsDir, group.name);
    for (const entry of fs.readdirSync(groupDir)) {
      if (!entry.endsWith(".js")) continue;
      tools.push({
        group: group.name,
        name: entry.slice(0, -3),
        command: `${group.name} ${entry.slice(0, -3)}`,
        file: path.join(groupDir, entry),
      });
    }
  }
  return tools.sort((a, b) => a.command.localeCompare(b.command));
}

function toolGroups() {
  const groups = new Map();
  for (const tool of availableTools()) {
    if (!groups.has(tool.group)) groups.set(tool.group, []);
    groups.get(tool.group).push(tool.name);
  }
  return groups;
}

function findTool(group, name) {
  return availableTools().find((tool) => tool.group === group && tool.name === name) || null;
}

function declaredDependencies() {
  const manifest = path.join(pluginRoot, "package.json");
  if (!fs.existsSync(manifest)) return [];
  const parsed = JSON.parse(fs.readFileSync(manifest, "utf8"));
  return Object.keys(parsed.dependencies || {}).sort();
}

// A package is present only when its own manifest is readable. A bare directory
// can survive a partial or interrupted install.
function installedDependencies() {
  return new Set(
    declaredDependencies().filter((name) =>
      fs.existsSync(path.join(pluginRoot, "node_modules", name, "package.json"))
    )
  );
}

function missingDependencies() {
  const installed = installedDependencies();
  return declaredDependencies().filter((name) => !installed.has(name));
}

// What one tool needs, not what the plugin declares. Gating every tool on every
// dependency made a machine that cannot reach the npm registry look like a
// machine on which nothing works, when a third of the tools import nothing.
function missingDependenciesForTool(tool) {
  const installed = installedDependencies();
  return requiredDependencies(tool.file, declaredDependencies())
    .filter((name) => !installed.has(name));
}

function dependencyFreeTools() {
  const declared = declaredDependencies();
  return availableTools()
    .filter((tool) => requiredDependencies(tool.file, declared).length === 0)
    .map((tool) => tool.command);
}

function isWithin(candidate, parent) {
  const relative = path.relative(parent, candidate);
  return relative === "" || (!relative.startsWith("..") && !path.isAbsolute(relative));
}

function workspaceShadowAdvisories(cwd = process.cwd()) {
  const workspaceRoot = path.resolve(cwd);
  if (workspaceRoot === pluginRoot) return [];

  const advisories = [];
  for (const name of ["agents", "skills"]) {
    const candidate = path.join(workspaceRoot, name);
    let entry;
    try {
      entry = fs.lstatSync(candidate);
    } catch (error) {
      if (error?.code === "ENOENT") continue;
      advisories.push(`${name}/ could not be inspected (${error?.code || "unknown error"}).`);
      continue;
    }

    if (entry.isSymbolicLink()) {
      try {
        const target = fs.realpathSync(candidate);
        advisories.push(
          isWithin(target, pluginRoot)
            ? `${name}/ is an inert link into the loaded plugin (old workaround).`
            : `${name}/ is a link outside the loaded plugin and may target another install.`
        );
      } catch (error) {
        advisories.push(
          error?.code === "ENOENT"
            ? `${name}/ is a dangling link.`
            : `${name}/ is a link whose target could not be inspected (${error?.code || "unknown error"}).`
        );
      }
      continue;
    }

    if (entry.isDirectory()) {
      advisories.push(
        `${name}/ is a real directory; if it copied the old workaround, it is frozen and inert.`
      );
    }
  }
  return advisories;
}

// pdf-parse requires a Node with a working `File` global. On an older runtime it
// fails deep inside a dependency with a message that says nothing about Node, so
// check the one constraint that actually matters and say so plainly.
function unsupportedNode() {
  const [major, minor] = process.versions.node.split(".").map(Number);
  const ok = (major === 20 && minor >= 16) || (major >= 22);
  return ok ? null : `Node ${process.versions.node}`;
}

function fail(message) {
  process.stderr.write(`labora: ${message}\n`);
  process.exit(1);
}

function runNpm(args, options = {}) {
  const bundledNpm = path.join(
    path.dirname(process.execPath),
    "node_modules",
    "npm",
    "bin",
    "npm-cli.js",
  );
  const command = process.platform === "win32" && fs.existsSync(bundledNpm)
    ? process.execPath
    : "npm";
  const commandArgs = command === process.execPath ? [bundledNpm, ...args] : args;
  return spawnSync(command, commandArgs, {
    cwd: pluginRoot,
    encoding: "utf8",
    timeout: options.timeout,
    // Puppeteer's postinstall downloads a ~1.9 GB browser. Setup must not do
    // that silently; PDF rendering reports its own requirement when used.
    env: { ...process.env, PUPPETEER_SKIP_DOWNLOAD: "1" },
  });
}

function replayNpmOutput(result) {
  if (result.stdout) process.stdout.write(sanitizeNpmOutput(result.stdout));
  if (result.stderr) process.stderr.write(sanitizeNpmOutput(result.stderr));
}

function configuredRegistry() {
  const result = runNpm(["config", "get", "registry"], { timeout: 5_000 });
  if (result.error || result.status !== 0) return "";
  return String(result.stdout || "").trim();
}

function inspectInstallHealth({ probeRegistry = false } = {}) {
  const versionResult = runNpm(["--version"], { timeout: 5_000 });
  if (versionResult.error || versionResult.status !== 0) {
    return {
      npmVersion: "",
      registry: "",
      registryStatus: "unavailable",
      diagnostic: classifyNpmFailure({
        error: versionResult.error,
        stderr: `${versionResult.stdout || ""}\n${versionResult.stderr || ""}`,
      }),
      detail: sanitizeNpmOutput(`${versionResult.stdout || ""}${versionResult.stderr || ""}`),
    };
  }

  const rawRegistry = configuredRegistry();
  const registry = sanitizeRegistryUrl(rawRegistry);
  if (!rawRegistry) {
    return {
      npmVersion: String(versionResult.stdout || "").trim(),
      registry: "",
      registryStatus: "unavailable",
      diagnostic: classifyNpmFailure(),
      detail: "",
    };
  }
  if (!probeRegistry) {
    return {
      npmVersion: String(versionResult.stdout || "").trim(),
      registry,
      registryStatus: "configured",
      diagnostic: null,
      detail: "",
    };
  }

  const probePackage = declaredDependencies()[0];
  const probeResult = runNpm(["view", probePackage, "version", "--json"], { timeout: 8_000 });
  if (probeResult.error || probeResult.status !== 0) {
    const detail = `${probeResult.stdout || ""}${probeResult.stderr || ""}`;
    return {
      npmVersion: String(versionResult.stdout || "").trim(),
      registry,
      registryStatus: "unavailable",
      diagnostic: classifyNpmFailure({
        error: probeResult.error,
        stderr: detail,
        registry: rawRegistry,
      }),
      detail: sanitizeNpmOutput(detail),
    };
  }
  return {
    npmVersion: String(versionResult.stdout || "").trim(),
    registry,
    registryStatus: "reachable",
    diagnostic: null,
    detail: "",
  };
}

function reportMissingDependencies(missing, tool) {
  process.stderr.write(
    `labora: ${tool} needs ${missing.length} dependenc${missing.length === 1 ? "y" : "ies"} ` +
    `that ${missing.length === 1 ? "is" : "are"} not installed: ${missing.join(", ")}\n` +
    `\nThis tool cannot run, but Labora remains in degraded advisory mode: agents,\n` +
    `skills, and dependency-free tools remain available. Diagnose npm and registry health:\n\n` +
    `  labora doctor\n\n` +
    `Refusing to run this tool. Do not approximate its deterministic calculation or\n` +
    `validation in an agent; a gate that cannot execute must not look like one that passed.\n`
  );
  const runnable = dependencyFreeTools();
  if (runnable.length) {
    process.stderr.write(
      `\nThese tools need no dependency and run now:\n  ${runnable.join(", ")}\n`
    );
  }
  process.exit(1);
}
function runSetup() {
  const useCleanInstall = fs.existsSync(path.join(pluginRoot, "package-lock.json"));
  const args = useCleanInstall
    ? ["ci", "--omit=dev"]
    : ["install", "--omit=dev", "--no-audit", "--no-fund"];
  process.stderr.write(`labora: installing dependencies into ${pluginRoot}\n`);
  process.stderr.write(`labora: npm ${args.join(" ")}\n`);
  const result = runNpm(args);
  replayNpmOutput(result);
  if (result.error || result.status !== 0) {
    const diagnostic = classifyNpmFailure({
      error: result.error,
      stderr: `${result.stdout || ""}\n${result.stderr || ""}`,
      registry: result.error?.code === "ENOENT" ? "" : configuredRegistry(),
    });
    process.stderr.write(`labora: ${diagnostic.summary}\nlabora: ${diagnostic.route}\n`);
    process.stderr.write(
      "labora: agents, skills, and dependency-free tools remain available in degraded advisory mode.\n",
    );
    process.exit(result.status ?? 1);
  }

  const stillMissing = missingDependencies();
  if (stillMissing.length) fail(`setup finished but these are still missing: ${stillMissing.join(", ")}`);
  process.stderr.write("labora: dependencies ready\n");
}

function chromeStatus() {
  // Resolved in a child process so a broken install cannot take doctor down -
  // reporting health is the one thing that has to work when nothing else does.
  const probe = "import('./src/lib/browser.js').then(m=>process.stdout.write(m.findChrome()||''))";
  const result = spawnSync(process.execPath, ["--input-type=module", "-e", probe], {
    cwd: pluginRoot,
    encoding: "utf8",
  });
  return (result.status === 0 && result.stdout.trim()) || null;
}

function runDoctor() {
  const missing = missingDependencies();
  const tools = availableTools();
  const stale = unsupportedNode();
  const chrome = chromeStatus();
  const installHealth = inspectInstallHealth({ probeRegistry: true });
  const lines = [
    `plugin root   ${pluginRoot}`,
    `working dir   ${process.cwd()}`,
    `node          ${process.version}${stale ? "  UNSUPPORTED, needs >=20.16 or >=22.3" : ""}`,
    `npm           ${installHealth.npmVersion || "unavailable"}`,
    `registry      ${installHealth.registry || "unavailable"} (${installHealth.registryStatus})`,
    `tools         ${tools.length} available${missing.length ? `, ${dependencyFreeTools().length} runnable without dependencies` : ""}`,
    `dependencies  ${missing.length === 0 ? "ready" : `MISSING: ${missing.join(", ")}`}`,
    `pdf renderer  ${chrome ? chrome : "no Chrome found — DOCX still works, PDF will not"}`,
    `mode          ${missing.length === 0
      ? "full deterministic capabilities installed"
      : "degraded advisory -- agents, skills, and dependency-free tools available"}`,
  ];
  process.stdout.write(lines.join("\n") + "\n");
  if (missing.length) {
    process.stdout.write(
      "\nDependency-backed tools cannot run and must not be approximated by an agent.\n",
    );
    if (installHealth.diagnostic) {
      process.stdout.write(
        `${installHealth.diagnostic.summary}\n${installHealth.diagnostic.route}\n`,
      );
      if (installHealth.diagnostic.kind === "unknown" && installHealth.detail.trim()) {
        process.stdout.write(`npm output:\n${installHealth.detail.trim()}\n`);
      }
    } else {
      process.stdout.write(
        `npm and the configured registry are ready. Run "${SETUP_COMMAND}" to install ` +
        "the missing deterministic capabilities.\n",
      );
    }
    process.exit(1);
  }
  if (installHealth.diagnostic) {
    process.stdout.write(
      "\nInstalled capabilities remain usable, but setup and updates are unavailable.\n" +
      `${installHealth.diagnostic.summary}\n${installHealth.diagnostic.route}\n`,
    );
    if (installHealth.diagnostic.kind === "unknown" && installHealth.detail.trim()) {
      process.stdout.write(`npm output:\n${installHealth.detail.trim()}\n`);
    }
  }
  if (stale) process.exit(1);
}

// Emitted by the sessionStart hook. Skills refer to the tools as "labora
// <tool>", but a plugin is installed to an unpredictable path that is not on
// PATH, so the model has no way to discover it. This binds that name to this
// absolute path for the session, and states up front whether the tools can
// actually run - a stage that cannot execute must never be mistaken for one
// that passed. It is strictly read-only: installing is the operator's call.
function announce() {
  const missing = missingDependencies();
  const shadowAdvisories = workspaceShadowAdvisories();
  const lines = [
    `labora plugin ${pluginVersion()} is installed at ${pluginRoot}.`,
    ``,
    `Skills and agents invoke deterministic tools as "labora <tool> [args]".`,
    `That command is not on PATH. Run it as:`,
    `  ${binPath} <tool> [args]`,
    `Run "${binPath} list" for the ${availableTools().length} available tools.`,
  ];
  if (shadowAdvisories.length) {
    lines.push(
      ``,
      `WORKSPACE ADVISORY: root-level agents/ or skills/ entries were found:`,
      ...shadowAdvisories.map((advisory) => `  - ${advisory}`),
      `Labora never reads these paths; prompts resolve from ${pluginRoot}.`,
      `Do not delete unrelated workspace content. If these entries came from the`,
      `retired cwd-resolution workaround, remove them after confirming their origin.`
    );
  }
  if (missing.length) {
    const runnable = dependencyFreeTools();
    lines.push(
      ``,
      `WARNING: ${missing.length} dependencies are not installed (${missing.join(", ")}),`,
      `so ${availableTools().length - runnable.length} of ${availableTools().length} tools will refuse to run.`,
      `Labora still works: the conversation, the skills and the agents are unaffected,`,
      `and only the steps that build or read a document need these packages.`,
      `Diagnose npm and registry health with:`,
      `  ${binPath} doctor`,
      `If doctor reports npm and the registry ready, it will direct the operator to setup.`,
      ``,
      `These ${runnable.length} tools need no dependency and DO run now:`,
      `  ${runnable.join(", ")}`
    );
  }
  process.stdout.write(JSON.stringify({ additionalContext: lines.join("\n") }) + "\n");
}

function groupedListing() {
  return [...toolGroups()]
    .map(([group, names]) => `  ${group}\n${names.map((name) => `    ${group} ${name}`).join("\n")}`)
    .join("\n");
}

function usage() {
  process.stdout.write(
    `labora — builds and inspects résumé documents for the labora plugin\n\n` +
    `Usage:\n` +
    `  labora <group> <tool> [args...]   run a tool\n` +
    `  labora <group>                    list one group\n` +
    `  labora list                       list every tool, grouped\n` +
    `  labora doctor                     report install health\n` +
    `  labora setup                      install dependencies into the plugin\n` +
    `  labora announce                   emit session context (used by the plugin hook)\n\n` +
    `Tools:\n${groupedListing()}\n`
  );
}

const [command, ...rest] = process.argv.slice(2);

if (!command || command === "help" || command === "--help" || command === "-h") {
  usage();
  process.exit(0);
}
if (command === "list") {
  process.stdout.write(`${groupedListing()}\n`);
  process.exit(0);
}
if (command === "doctor") {
  runDoctor();
  process.exit(0);
}
if (command === "setup") {
  runSetup();
  process.exit(0);
}
if (command === "announce") {
  announce();
  process.exit(0);
}

// Both segments are validated as plain names before either reaches the
// filesystem, so no argument can ever be turned into a path.
const SEGMENT = /^[a-z0-9][a-z0-9-]*$/;
if (!SEGMENT.test(command)) {
  fail(`"${command}" is not a valid tool group. Run "labora list".`);
}

const groups = toolGroups();
if (!groups.has(command)) {
  fail(`unknown tool group "${command}". Run "labora list".`);
}

// `labora render` with nothing after it lists the group rather than erroring.
// Asking what is available is the most common reason to type a bare group name.
const [subcommand, ...toolArgs] = rest;
if (!subcommand) {
  process.stdout.write(
    `${command}\n${groups.get(command).map((name) => `  ${command} ${name}`).join("\n")}\n`
  );
  process.exit(0);
}
if (!SEGMENT.test(subcommand)) {
  fail(`"${subcommand}" is not a valid tool name. Run "labora ${command}".`);
}

const tool = findTool(command, subcommand);
if (!tool || !fs.existsSync(tool.file)) {
  fail(`unknown tool "${command} ${subcommand}". Run "labora ${command}".`);
}

const stale = unsupportedNode();
if (stale) {
  fail(
    `${stale} is too old to run labora's tools; they need >=20.16 or >=22.3.\n` +
    `Upgrade Node, or run this through a newer one.`
  );
}

const missing = missingDependenciesForTool(tool);
if (missing.length) reportMissingDependencies(missing, tool.command);

// Spawn rather than import: the tool reads process.argv and calls process.exit,
// so importing it would hand it this dispatcher's arguments and let it end this
// process. Spawning preserves its argv, its exit code, and the caller's cwd -
// which is the persona workspace and must stay that way.
const result = spawnSync(process.execPath, [tool.file, ...toolArgs], { stdio: "inherit" });
if (result.error) fail(`could not run ${tool.command}: ${result.error.message}`);
if (result.signal) fail(`${tool.command} terminated with signal ${result.signal}`);
process.exit(result.status ?? 1);
