node_modules/
.DS_Store

# Downloaded at run time, not authored: OCR language data and any other
# machine-local artifact the tools cache next to the plugin.
.cache/

docs/

# Persona data is PERSONAL: career history, performance reviews, past resumes,
# generated resumes. It now lives OUTSIDE this repo in a private workspace
# (see labora.example.json). The rules below remain as defence in depth for the
# legacy in-repo layout: everything under data/personas is ignored EXCEPT the
# `example` persona, which is the committed reference fixture.
data/personas/*
!data/personas/example/
data/applicant/

# Machine-local pointer to the private persona workspace. Personal because it
# records a machine-specific path; labora.example.json is the committed template.
labora.json

# Credentials and env
auth/
.env
.env.*
*.pem
*.key
**/credentials*.json
**/client_secret*.json

# Local assistant settings: these record machine-specific paths and per-user
# permission grants, so they are personal to whoever cloned the repo.
.claude/settings.local.json
.copilot/settings.local.json

# Local runtime caches and per-style iteration notes
.ollama-cache/
prompts/**/notes.md
prompts/**/.improve/
# Playwright MCP session artifacts. Page snapshots and console logs from an
# authenticated browsing session can contain personal data; never commit them.
.playwright-mcp/

# >>> kai workspace >>>
# labora is a distributable plugin, not a kai-stewarded product repo. The kai
# workspace here is developer-local: it must not ship in the marketplace package
# and it must not leave `git status` permanently dirty, because a working copy
# that is never clean trains everyone to ignore the one file that does matter.
/kai/
/.kai/
# Retired local state stays private during explicit migration.
/.persona-self/
# Retired schema-1 root-level personal lane stays private until migration completes.
/personal/
**/storageState*.json
# <<< kai workspace <<<
